---
import Backlinks from "../components/notes/Backlinks.astro";
import NoteMeta from "../components/notes/NoteMeta.astro";
import { WikiPreview } from "../components/notes/WikiPreview";
import BaseLayout from "./BaseLayout.astro";
import type { NoteEntry } from "../lib/content/repository";
import { siteConfig } from "../config/site";

interface Heading { depth: number; slug: string; text: string; }
interface Reference { href: string; title: string; summary: string; }
interface Props {
  note: NoteEntry;
  headings: Heading[];
  backlinks: NoteEntry[];
  references: Reference[];
}
const { note, headings, backlinks, references } = Astro.props;
---

<BaseLayout title={`${note.data.title} | ${siteConfig.title}`} description={note.data.summary} article>
  <Fragment slot="head">
    <meta property="article:published_time" content={note.data.publishedAt.toISOString()} />
    {note.data.updatedAt && <meta property="article:modified_time" content={note.data.updatedAt.toISOString()} />}
  </Fragment>
  <div class="note-layout" data-note-grid>
    <aside class="note-sidebar" data-desktop-sidebar aria-label="노트 탐색">
      <p class="eyebrow">목차</p>
      {headings.length ? <ol>{headings.map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol> : <p>이 노트에는 목차가 없습니다.</p>}
    </aside>
    <div class="note-reading">
      <button class="note-toc-toggle" type="button" aria-controls="mobile-note-toc" aria-expanded="false">노트 탐색 열기</button>
      <nav id="mobile-note-toc" class="note-mobile-toc" aria-label="노트 목차" hidden>
        {headings.length ? <ol>{headings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol> : <p>이 노트에는 목차가 없습니다.</p>}
      </nav>
      <header class="note-header">
        <p class="eyebrow">{note.data.topic}</p>
        <h1 data-pagefind-meta="title">{note.data.title}</h1>
        <p class="note-summary">{note.data.summary}</p>
        <NoteMeta publishedAt={note.data.publishedAt} updatedAt={note.data.updatedAt} tags={note.data.tags} />
      </header>
      <div class="prose"><slot /></div>
      {references.length > 0 && <section class="note-references" aria-labelledby="references-title"><h2 id="references-title">연결된 노트</h2><ul>{references.map((reference) => <li><WikiPreview client:load {...reference} /></li>)}</ul></section>}
      <Backlinks notes={backlinks} />
    </div>
  </div>
</BaseLayout>

<script>
  const button = document.querySelector<HTMLButtonElement>(".note-toc-toggle");
  const navigation = document.querySelector<HTMLElement>("#mobile-note-toc");
  button?.addEventListener("click", () => {
    const expanded = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!expanded));
    if (navigation) navigation.hidden = expanded;
  });
</script>
