---
export const prerender = true;

import NoteCard from "../../components/notes/NoteCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedNotes } from "../../lib/content/repository";
const notes = await getPublishedNotes();
---

<BaseLayout title="노트 | minji.log" description="개발과 데이터에 관한 연결된 노트입니다.">
  <header class="page-intro"><p class="eyebrow">KNOWLEDGE BASE</p><h1 data-pagefind-meta="title">노트</h1><p>배운 것을 짧고 연결 가능한 글로 기록합니다.</p></header>
  <section class="card-list" data-pagefind-body aria-label="공개 노트">{notes.length ? notes.map((note) => <NoteCard note={note} />) : <p>공개된 노트가 아직 없습니다.</p>}</section>
</BaseLayout>
